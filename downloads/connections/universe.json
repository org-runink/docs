    {
      "id": "ANOM-1",
      "kind": "overcharged_freight_invoice",
      "entity": "INV-90003",
      "summary": "INV-90003 for SHP-50003 bills 3.84/mile against a contracted 3.25/mile (+15.8% on the total)",
      "evidence": [
        {
          "type": "mysql",
          "path": "sources/mysql/02_data.sql",
          "dataset": "freight.freight_invoices",
          "match": "'INV-90003'",
          "note": "billed_rate_per_mile 3.84"
        },
        {
          "type": "mysql",
          "path": "sources/mysql/02_data.sql",
          "dataset": "freight.rate_contracts",
          "match": "'RC-CAR-01-2026'",
          "note": "contracted rate_per_mile 3.25"
        },
        {
          "type": "files",
          "path": "sources/files/s3/quillmere-claims/invoices/INV-90003.pdf",
          "dataset": "freight_invoice_documents",
          "match": "Rate per mile: USD 3.84"
        },
        {
          "type": "files",
          "path": "sources/files/sftp/outbound/carrier_rates_2026.tsv",
          "dataset": "carrier_rate_sheet",
          "match": "CAR-01\tZQAL\t3.25",
          "note": "the carrier's own rate sheet"
        },
        {
          "type": "d365",
          "path": "sources/d365/data_VendorInvoiceHeaders.json",
          "dataset": "VendorInvoiceHeaders",
          "match": "\"InvoiceAmount\": 494.01",
          "note": "approved for payment at the billed amount"
        },
        {
          "type": "kafka",
          "path": "streams/kafka/records.jsonl",
          "dataset": "quillmere.freight.rate-variance.v1",
          "match": "\"rate_per_mile\":3.84,\"contracted_rate_per_mile\":3.25,\"variance_pct\":18.20",
          "note": "the ksqlDB stream INVOICE_RATE_VARIANCE: a billed rate more than 5% over contract"
        }
      ]
    },
